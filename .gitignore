# Binaries
*.exe
*.dll
*.so
*.dylib
/dist/
/build/

# Test artifacts
*.test
*.out
coverage.html

# Wails — ignore built frontend output but keep a placeholder so
# `go build ./...` works on a fresh clone (go:embed needs the dir).
cmd/sidesave-app/frontend/dist/*
!cmd/sidesave-app/frontend/dist/.gitkeep
cmd/sidesave-app/frontend/node_modules/
cmd/sidesave-app/build/bin/

# IDE
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Generated by `wails build` on every run — bindings and the NSIS
# installer templates are regenerated in CI, so tracking them only
# produces conflicts between machines.
cmd/sidesave-app/frontend/wailsjs/
cmd/sidesave-app/build/windows/installer/

# Local flatpak-builder scratch output (build-dir/ and .flatpak-builder/
# are excluded already, likely by a global excludesFile — these two aren't).
packaging/flatpak/repo/
packaging/flatpak/stage/
